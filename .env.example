# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# Firebase
# Optional if your service account JSON already matches the right project,
# but keeping it set makes the configuration explicit.
FIREBASE_PROJECT_ID=sellyourscrap-53804
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Rate Limit
OTP_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_WINDOW_SEC=300

# Operations auth
ADMIN_LOGIN_CODES=founder_admin_code_here

# Mail
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=partner@recyclaro.com
SMTP_PASS=
SMTP_FROM_EMAIL=partner@recyclaro.com
PICKUP_ACK_EMAIL=partner@recyclaro.com
PICKUP_ACK_CC_EMAILS=neeraj@recyclaro.com
